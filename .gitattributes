# Mantener LF en todo el repo (Unity friendly)
* text=auto eol=lf

# Asegurar Unity + C# en LF
*.cs        text eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.compute   text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.controller text eol=lf
*.meta      text eol=lf

# Binarios típicos (no tocar finales de línea)
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
